<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <title>Lista de Paqueras</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        h1 { color: #333; }
        nav { margin-bottom: 20px; }
        nav a { margin-right: 12px; text-decoration: none; color: #0066cc; }
        table { border-collapse: collapse; width: 60%; }
        th { background-color: #0066cc; color: white; padding: 10px 16px; text-align: left; }
        td { padding: 8px 16px; border-bottom: 1px solid #ddd; }
        tr:hover td { background-color: #f5f5f5; }
        .vazio { color: #888; font-style: italic; margin-top: 12px; }
    </style>
</head>
<body>
    <h1>💘 Paqueras</h1>
    <nav>
        <a th:href="@{/}">Home</a>
        <a th:href="@{/p1}">Lysandre</a>
        <a th:href="@{/p2}">Armin</a>
        <a th:href="@{/formpaquera}">Cadastrar Paquera</a>
        <a th:href="@{/paqueras}">Ver Paqueras</a>
    </nav>

    <table th:if="${not #lists.isEmpty(paqueras)}">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Idade</th>
            </tr>
        </thead>
        <tbody>
            <tr th:each="p : ${paqueras}">
                <td th:text="${p.nome}">Nome</td>
                <td th:text="${p.idade}">Idade</td>
            </tr>
        </tbody>
    </table>

    <p class="vazio" th:if="${#lists.isEmpty(paqueras)}">Nenhuma paquera cadastrada ainda. 😢</p>
</body>
</html>
